#!/bin/sh

# runit service for the PSI genset driver. The serial port is configured via
# PORT= in /data/apps/dbus-psi-genset/config.ini (read by the driver), so this
# script needs no per-port editing.

trap 'kill -TERM $PID' TERM INT

exec 2>&1
exec bash /data/apps/dbus-psi-genset/start-psi-genset.sh &

PID=$!
wait $PID
exit $?
